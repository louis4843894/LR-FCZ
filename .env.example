# Vercel website: configure these for Production and Preview.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server URL override (same project as NEXT_PUBLIC_SUPABASE_URL).
SUPABASE_URL=
# Local data synchronization tools only; not required by the Vercel website.
SUPABASE_SECRET_KEY=

# Local-only validated game database (Node.js 24 built-in SQLite)
LR_LOCAL_DATABASE_PATH=data/local/lr.private.sqlite
